# Normalize line endings for Godot text resources so diffs stay readable
# across Windows / macOS / Linux contributors.
* text=auto eol=lf

*.gd      text eol=lf
*.tscn    text eol=lf
*.tres    text eol=lf
*.godot   text eol=lf
*.cfg     text eol=lf
*.md      text eol=lf
*.py      text eol=lf

# Binary assets should never be line-ending converted.
*.png     binary
*.jpg     binary
*.webp    binary
*.ogg     binary
*.wav     binary
*.glb     binary
*.ttf     binary
